---
/**
 * 「常听音乐人」卡片长廊
 *
 * - 横向可滚动；卡片可点击翻面（正面：照片 + 名字 + 别名；背面：推荐歌曲）
 * - **纯 CSS 交互**：隐藏 checkbox + :checked 驱动 3D 翻转，组件不输出任何 <script>
 *   （主题用 Swup 做无刷新切页，内联脚本会被重复执行，纯 CSS 可完全绕开该问题；
 *     同时保留键盘可操作性：Tab 聚焦 + 空格翻面）
 * - 数据来自 src/data/artists.json（由 `pnpm artists` 生成，picks 可手工编辑）
 */
import { Icon } from "astro-icon/components";
import artistsData from "@/data/artists.json";
import type { ArtistEntry } from "@/types/artists";

interface Props {
	/** 分组标题，传空字符串则不显示标题行 */
	title?: string;
	/** 标题右侧的提示文字 */
	note?: string;
	class?: string;
}

const {
	title = "常听音乐人",
	note = "轻点卡片翻面，看看我常听什么",
	class: className,
} = Astro.props;

const artists = artistsData as ArtistEntry[];

/** 取名字首字做水印装饰（英文名取首字母大写） */
const watermarkOf = (name: string) => [...name][0]?.toUpperCase() ?? "♪";

/** 正面底部的一行小字：专辑 / 歌曲数量 */
const albumCountLabel = (artist: ArtistEntry) =>
	`${artist.albumCount} 专辑 · ${artist.songCount} 首歌`;
---

<widget-layout
	data-id="artist-gallery"
	data-is-collapsed="false"
	class:list={["artist-gallery card-base px-4 py-4 sm:px-5", className]}
>
	{
		title && (
			<div class="artist-gallery-head">
				<h3 class="artist-gallery-title">{title}</h3>
				{note && <span class="artist-gallery-note">{note}</span>}
			</div>
		)
	}

	<div class="artist-corridor">
		<ul class="artist-track">
			{
				artists.map((artist, index) => (
					<li class="artist-item">
						<input
							type="checkbox"
							class="artist-card-toggle"
							id={`artist-flip-${artist.key}`}
							aria-label={`展开 ${artist.name} 的推荐歌曲`}
						/>
						<label
							class="artist-card"
							for={`artist-flip-${artist.key}`}
							style={`--artist-stagger: ${index * 45}ms`}
						>
							<span class="artist-card-inner">
								{/* ── 正面 ── */}
								<span class="artist-face artist-face-front">
									<img
										class="artist-photo"
										src={artist.photo}
										alt={artist.name}
										width="480"
										height="480"
										loading="lazy"
										decoding="async"
									/>
									<span class="artist-photo-mask" aria-hidden="true" />
									<span class="artist-watermark" aria-hidden="true">
										{watermarkOf(artist.name)}
									</span>
									<span class="artist-front-info">
										<span class="artist-name">{artist.name}</span>
										<span class="artist-alias">{artist.alias}</span>
										<span class="artist-stats">
											{albumCountLabel(artist)}
										</span>
									</span>
								</span>

								{/* ── 背面 ── */}
								<span class="artist-face artist-face-back">
									<span class="artist-back-head">
										<Icon
											name="material-symbols:graphic-eq-rounded"
											class="artist-back-icon"
										/>
										<span class="artist-back-label">推荐给你</span>
									</span>
									<span class="artist-back-name">{artist.name}</span>
									<ol class="artist-picks">
										{artist.picks.slice(0, 4).map((pick) => (
											<li class="artist-pick">{pick}</li>
										))}
									</ol>
									<span class="artist-alias artist-back-alias">
										{artist.alias}
									</span>
								</span>
							</span>
						</label>
					</li>
				))
			}
		</ul>
	</div>
</widget-layout>

<style>
	/* ---------------------------------------------------------------------
	 * 容器
	 * ------------------------------------------------------------------- */
	.artist-gallery {
		position: relative;
	}

	.artist-gallery-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
	}

	.artist-gallery-title {
		position: relative;
		margin: 0;
		padding-left: 0.75rem;
		font-size: 1rem;
		font-weight: 700;
		color: var(--deep-text);
	}

	/* 与主题其它分组标题一致的竖条 */
	.artist-gallery-title::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.25em;
		width: 0.25rem;
		height: 1rem;
		border-radius: 0.375rem;
		background: var(--primary);
	}

	.artist-gallery-note {
		font-size: 0.75rem;
		color: var(--content-meta);
		white-space: nowrap;
	}

	/* ---------------------------------------------------------------------
	 * 长廊：横向滚动 + 两端渐隐遮罩
	 * ------------------------------------------------------------------- */
	.artist-corridor {
		/* 左右留白让首尾卡片不贴边；上下留白给悬停上浮与阴影呼吸空间
		   （overflow-x:auto 会让 overflow-y 也变成裁剪，不留白会把上浮效果切掉） */
		margin: 0 -0.25rem;
		padding: 0.5rem 0.25rem 0.9rem;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x proximity;
		scroll-padding-left: 0.25rem;
		scrollbar-width: none;
		-ms-overflow-style: none;
		-webkit-overflow-scrolling: touch;
		/* 两侧渐隐：滚动边缘不是硬切 */
		mask-image: linear-gradient(
			to right,
			transparent 0,
			#000 1.75rem,
			#000 calc(100% - 1.75rem),
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0,
			#000 1.75rem,
			#000 calc(100% - 1.75rem),
			transparent 100%
		);
	}

	.artist-corridor::-webkit-scrollbar {
		display: none;
	}

	.artist-track {
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		width: max-content;
	}

	.artist-item {
		scroll-snap-align: start;
		flex: 0 0 auto;
	}

	/* 隐藏 checkbox 但保留键盘可聚焦（不可用 display:none / visibility:hidden） */
	.artist-card-toggle {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: 0;
		padding: 0;
		opacity: 0;
		pointer-events: none;
	}

	/* ---------------------------------------------------------------------
	 * 卡片与 3D 翻转
	 * ------------------------------------------------------------------- */
	.artist-card {
		position: relative;
		display: block;
		width: 10.5rem;
		height: 18.5rem;
		perspective: 1000px;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.artist-card-inner {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 620ms var(--ease-standard);
	}

	/* 翻转触发（点击/空格切换 checkbox） */
	.artist-card-toggle:checked + .artist-card .artist-card-inner {
		transform: rotateY(180deg);
	}

	/* 键盘可达的焦点环 */
	.artist-card-toggle:focus-visible + .artist-card .artist-face {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.artist-face {
		position: absolute;
		inset: 0;
		display: flex;
		overflow: hidden;
		border: 1px solid var(--line-divider);
		border-radius: 0.75rem;
		background: var(--card-bg);
		box-shadow: var(--shadow-sm);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		transform: rotateY(0deg);
		transition:
			box-shadow 250ms var(--ease-standard),
			border-color 250ms var(--ease-standard),
			translate 250ms var(--ease-standard);
	}

	.artist-face-back {
		transform: rotateY(180deg);
		flex-direction: column;
		padding: 0.85rem 0.8rem;
		background:
			linear-gradient(
				160deg,
				color-mix(in srgb, var(--primary) 10%, transparent) 0%,
				transparent 55%
			),
			var(--card-bg);
	}

	/* 悬停：卡片上浮 + 主题色描边 + 柔光 */
	@media (hover: hover) {
		.artist-card:hover .artist-face {
			translate: 0 -4px;
			border-color: color-mix(in srgb, var(--primary) 45%, var(--line-divider));
			box-shadow:
				var(--shadow-md),
				0 10px 26px -16px color-mix(in srgb, var(--primary) 60%, transparent);
		}

		.artist-card:hover .artist-watermark {
			opacity: 0.2;
			translate: 0 -3px;
		}

		.artist-card:hover .artist-pick {
			border-color: color-mix(in srgb, var(--primary) 32%, var(--line-divider));
		}
	}

	/* ---------------------------------------------------------------------
	 * 正面
	 * ------------------------------------------------------------------- */
	.artist-face-front {
		flex-direction: column;
	}

	.artist-photo {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: top center;
		background: var(--muted);
		transition: scale 620ms var(--ease-standard);
	}

	@media (hover: hover) {
		.artist-card:hover .artist-photo {
			scale: 1.035;
		}
	}

	/* 照片底部渐隐，让名字叠在渐变上而不是压在一块色块上 */
	.artist-photo-mask {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			to top,
			var(--card-bg) 22%,
			color-mix(in srgb, var(--card-bg) 72%, transparent) 42%,
			transparent 66%
		);
	}

	/* 巨型水印字 */
	.artist-watermark {
		position: absolute;
		right: -0.1rem;
		bottom: 3.4rem;
		font-size: 4.75rem;
		font-weight: 900;
		line-height: 1;
		color: color-mix(in srgb, var(--primary) 42%, transparent);
		opacity: 0.12;
		pointer-events: none;
		user-select: none;
		transition:
			opacity 250ms var(--ease-standard),
			translate 250ms var(--ease-standard);
	}

	.artist-front-info {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin-top: auto;
		padding: 0 0.8rem 0.7rem;
	}

	.artist-name {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--deep-text);
	}

	.artist-alias {
		font-size: 0.72rem;
		line-height: 1.3;
		color: var(--content-meta);
	}

	.artist-stats {
		margin-top: 0.15rem;
		font-size: 0.66rem;
		color: color-mix(in srgb, var(--primary) 78%, var(--content-meta));
	}

	/* ---------------------------------------------------------------------
	 * 背面
	 * ------------------------------------------------------------------- */
	.artist-back-head {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--primary);
	}

	.artist-back-icon {
		width: 0.9rem;
		height: 0.9rem;
		flex: 0 0 auto;
	}

	.artist-back-label {
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.artist-back-name {
		margin-top: 0.3rem;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--deep-text);
	}

	.artist-picks {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin: 0.55rem 0 0;
		padding: 0;
		list-style: none;
	}

	.artist-pick {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.26rem 0.5rem 0.26rem 0.45rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--primary) 5%, transparent);
		font-size: 0.72rem;
		line-height: 1.35;
		color: var(--deep-text);
		transition: border-color 200ms var(--ease-standard);
	}

	/* 序号小圆点 */
	.artist-pick::before {
		content: "";
		width: 0.3rem;
		height: 0.3rem;
		flex: 0 0 auto;
		border-radius: 9999px;
		background: var(--primary);
		opacity: 0.75;
	}

	.artist-back-alias {
		margin-top: auto;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--line-divider);
		font-size: 0.66rem;
		color: var(--content-meta);
	}

	/* ---------------------------------------------------------------------
	 * 无障碍：尊重「减少动态效果」偏好
	 * ------------------------------------------------------------------- */
	@media (prefers-reduced-motion: reduce) {
		.artist-card-inner,
		.artist-photo,
		.artist-face,
		.artist-watermark,
		.artist-pick {
			transition: none;
		}

		@media (hover: hover) {
			.artist-card:hover .artist-photo {
				scale: 1;
			}

			.artist-card:hover .artist-face {
				translate: 0 0;
			}
		}
	}
</style>
